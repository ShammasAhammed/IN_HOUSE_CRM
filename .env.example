# Copy to .env.local and fill in. Never commit .env.local.

# Database (docker compose up -d gives these)
DATABASE_URL=postgres://oppllo:oppllo@localhost:5432/oppllo_one
DATABASE_URL_TEST=postgres://oppllo:oppllo@localhost:5432/oppllo_one_test

# Auth.js — generate with: npx auth secret. Also signs the five-minute links to HR documents (D78).
AUTH_SECRET=
# Google OAuth client (owner creates it in Google Cloud console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Development only: "sign in as" any seeded person without Google. Ignored in production.
AUTH_DEV_LOGIN=1

# Sentry (later)
SENTRY_DSN=

# Scheduled jobs: the host's scheduler sends "Authorization: Bearer <CRON_SECRET>" to /api/jobs/daily.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Where uploaded files go: "postgres" (default, D78) or "google_drive" (D79; setup in docs/google-drive.md).
# Files saved before a switch keep opening from where they are.
FILE_STORAGE=postgres
# Google Drive service account (only with FILE_STORAGE=google_drive). Paste the key on one line with \n for line breaks.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# The id at the end of the shared-drive folder's address: drive.google.com/drive/folders/<this>
GOOGLE_DRIVE_FOLDER_ID=
# A folder per new client (works with any FILE_STORAGE): the Drive folder the client folders go in. Same service account.
GOOGLE_DRIVE_CLIENTS_FOLDER_ID=

# Email (D82): the daily job emails each person what they haven't read. Without a key, emails are only logged.
RESEND_API_KEY=
MAIL_FROM=Oppllo One <one@oppllo.com>
# The app's address, for links in emails.
APP_URL=https://one.oppllo.com

# The prospect CRM, read-only (docs/crm-link.md, D84). Without these, the won-leads list and pipeline stay empty.
CRM_FIREBASE_PROJECT_ID=oppllo-crm
CRM_FIREBASE_CLIENT_EMAIL=
CRM_FIREBASE_PRIVATE_KEY=

# First sign-in on a new (hosted) database: this Google account becomes the owner. Ignored once anyone exists.
OWNER_EMAIL=
OWNER_NAME=

# AI (Stages 9 and 12.3, docs/ai.md). Each key switches on one provider; the router picks the model per job and skips a
# provider with no key. Without any key the AI says it isn't switched on. The monthly spending limit is set in
# Settings → AI (₹2,000 until changed) and covers all of them. Paid API keys only, never a free tier.
ANTHROPIC_API_KEY=
# ChatGPT (OpenAI API).
OPENAI_API_KEY=
# Gemini (Google AI Studio, billing switched on).
GEMINI_API_KEY=
# The decision helper (TypeSafe Jev, early access). Without it, Claude Haiku answers the same small questions.
TYPESAFE_API_KEY=
# Optional: one more Claude model for the router to know about. Not needed: the owner orders models in Settings → AI.
AI_MODEL=
# Rupees per US dollar for the spending figures. Default 90.
AI_INR_PER_USD=

# Lead intake (Stage 10a.4, docs/lead-intake.md). Landing pages need nothing here: their keys come from the CRM.
# Meta lead ads: the app's secret, the verify token you type into the webhook setup, and the system user's token.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
# Optional: the Facebook Page id (when Meta doesn't send it) and the Graph API version (default v23.0).
META_PAGE_ID=
META_GRAPH_VERSION=
# Google Ads lead form: the key you type into "Lead delivery → Key".
GOOGLE_LEAD_WEBHOOK_KEY=
# Results back to the ads (Stage 10a.5). Meta: a Conversions API token (or META_ACCESS_TOKEN is used). Google: a long
# random key that goes at the end of the CSV address Google Ads fetches daily.
META_CAPI_TOKEN=
GOOGLE_CONVERSIONS_UPLOAD_KEY=

# Meta ad results on client pages (Stage 10.1, docs/meta-ads.md): a system user token with ads_read on the clients'
# ad accounts. Falls back to META_ACCESS_TOKEN.
META_ADS_TOKEN=

# Instagram/Facebook embeds in the swipe file and on boards (Stage 13.2, docs/share-to-oppllo.md): a token from a Meta
# app with "oEmbed Read" (an app token is "APP_ID|CLIENT_TOKEN"). Falls back to META_ACCESS_TOKEN; without either,
# Instagram and Facebook links show a card with "Open on Instagram".
META_OEMBED_TOKEN=

# Zoho Books draft invoices from the client page (docs/zoho-books.md). Leave empty to keep it off.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# Zoho data centre: in (India, default), com, eu …
ZOHO_DC=
